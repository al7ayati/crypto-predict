# Firebase Web App configuration
# Copy this file to .env.local and replace the example values.
# Do not commit .env.local.

VITE_FIREBASE_API_KEY=replace_with_your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=crypto-predict-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=crypto-predict-app
VITE_FIREBASE_STORAGE_BUCKET=crypto-predict-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_your_messaging_sender_id
VITE_FIREBASE_APP_ID=replace_with_your_firebase_app_id
